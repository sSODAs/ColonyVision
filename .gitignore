# ColonyVision final repository policy

# Temporary Google Colab runtime and notebooks (local only)
/colab_demo/
*.ipynb

# Local/private datasets and generated results
# raw/test50 is the only raw-image subset published for reproducible testing.
/raw/*
!/raw/test50/
/dataset/
/annotations/
/output/
/outputs/
/runs/
/results/
/predictions/
/checkpoints/
/artifacts/
/data/
/datasets/

# Local environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.tox/
.nox/
.cache/
.uv/
build/
dist/
*.log
*.tmp
*.part

# Machine-specific settings / secrets
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.pem
*.key
id_rsa
id_ed25519

# Model weights: only the final student checkpoint is publishable.
*.pt
*.pth
*.ptl
*.ckpt
*.safetensors
*.onnx
*.engine
*.tflite
*.pb
*.h5
*.hdf5
*.keras
*.mlmodel
*.caffemodel
*.weights
*.torchscript
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.bin
*.gguf
*.model

!/weights/
/weights/*
!/weights/colonyvision_student_v1.pt

# Binary media / archives remain local.
*.jpg
*.jpeg
*.png
*.bmp
*.tif
*.tiff
*.webp
*.gif
*.dcm
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.mp3
*.zip
*.7z
*.rar
*.tar
*.gz
*.zst

# CSV is blocked by default; only frozen Test50 metadata is publishable.
*.csv
!/evaluation/
!/evaluation/test50/
!/evaluation/test50/selection.csv
!/evaluation/test50/ground_truth_points.csv
!/evaluation/test50/ground_truth_summary.csv
!/evaluation/test50/reference_metrics.csv

# Re-allow the exact frozen Test50 images after the global media rules above.
!/raw/test50/*

# One vetted, lightweight preview for the public README (not generated output folders).
!/images/
/images/*
!/images/preview.jpg

# Other large/local data formats
*.tsv
*.parquet
*.feather
*.arrow
*.sqlite
*.sqlite3
*.db
